# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Environment & secrets
.env
.env.*
!.env.example

# Heavy checkpoints & serialized artifacts
saved_models/*.pkl
saved_models/*.joblib
*.pkl
*.joblib
*.h5
*.pt
*.pth

# Raw / large data (keep directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep

# Logs & reports generated at runtime
*.log
logs/
mlruns/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
